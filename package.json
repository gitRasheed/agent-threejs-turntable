{
  "name": "agent-threejs-turntable",
  "version": "0.1.0",
  "description": "Headless 3D asset checks for coding agents: mesh, palette and shape gates, nine-view contact sheets, batch runs, and a WebGPU smoke probe.",
  "keywords": [
    "agent-threejs-turntable",
    "threejs",
    "three",
    "turntable",
    "glb",
    "gltf",
    "3d-qa",
    "ci",
    "playwright",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gitRasheed/agent-threejs-turntable.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-threejs-turntable": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSE",
    "skills"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "gpu-probe": "node dist/cli.js gpu-probe",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "three": "^0.187.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
